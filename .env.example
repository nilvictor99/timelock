APP_NAME=TimeLock-v
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# El puerto lo publica compose.yaml (APP_PORT, por defecto 80).
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Zona horaria de la app. Postgres almacena e interpreta el wall-clock en esta
# zona, y los payloads de UI serializan fechas sin offset (Y-m-d\TH:i:s).
# Si no coincide con la del usuario, el calendario y los filtros por rango se
# desplazan de dia. Debe ser un identificador IANA valido.
APP_TIMEZONE=America/Lima

# compose.yaml los usa para el usuario del contenedor. En Linux, normalmente el
# uid/gid local: consultalo con `id -u` / `id -g`.
WWWUSER=1000
WWWGROUP=1000

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: el host de Postgres es el nombre del servicio en compose.yaml.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
# Estas tres credenciales tambien se pasan a Postgres como POSTGRES_*
# por compose.yaml: si no coinciden, el contenedor arranca con otras.
DB_DATABASE=timelock
DB_USERNAME=timelock
DB_PASSWORD=timelock

# SQLite alternative
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# La autenticacion de TimeLock no usa este driver: AuthService emite su propia
# cookie `timelock_session`. Este es el store de sesion de Laravel, para el resto
# de middleware de `web`.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- AI providers (AiService) -----------------------------------------------
# Todas estas variables son OPCIONALES. Sin `AI_PROVIDER` ni claves, el
# generador de sugerencias funciona por reglas y la app opera igual.
#
# Valores validos de AI_PROVIDER (deben coincidir con los de la UI en
# Ajustes -> Integracion IA, que tienen prioridad sobre esta variable):
#   OPENAI | OPENROUTER | NVIDIA_NIM | ANTHROPIC | GOOGLE_GEMINI | OLLAMA | OPENCODE | CUSTOM
#
# Cada peticion saliente se valida: solo HTTPS, solo hosts autorizados por
# provider y solo IP publicas (guard anti-SSRF). Si el proveedor falla, las
# sugerencias degradan a las reglas en lugar de romper la pantalla.
AI_PROVIDER=
AI_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_API_KEY=
# OLLama corre fuera del contenedor: desde Docker hay que apuntar al host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
OPENCODE_BASE_URL=https://opencode.ai/v1
# Fallback de CUSTOM_AI_BASE_URL.
AI_BASE_URL=
